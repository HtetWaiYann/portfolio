---
import { Icon } from 'astro-icon/components';

const links = [
	{ href: "#intro", icon: "lucide:house", label: "Home" },
	{ href: "#projects", icon: "lucide:folder", label: "Projects" },
	{ href: "#experience", icon: "lucide:briefcase", label: "Experience" },
	{ href: "#skills", icon: "lucide:wrench", label: "Skills" },
	{ href: "#contact", icon: "lucide:square-pen", label: "Contact" },
];
---

<nav
	class="fixed bottom-6 left-1/2 z-50 -translate-x-1/2"
	aria-label="Section navigation"
>
	<div
		class="flex items-center gap-1 rounded-full px-3 py-2.5 shadow-2xl shadow-black/60"
		style="background: rgba(22, 22, 22, 0.85); border: 1px solid rgba(255,255,255,0.07); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px)"
	>
		{links.map((link) => (
			<a
				href={link.href}
				data-nav={link.href.slice(1)}
				aria-label={link.label}
				class="nav-link flex h-10 w-10 cursor-pointer items-center justify-center rounded-full text-[#888888] transition-all duration-200 hover:bg-white/10 hover:text-white"
			>
				<Icon name={link.icon} width="19" height="19" />
			</a>
		))}
	</div>
</nav>

<style>
	.nav-link.active {
		color: #ffffff;
		background: rgba(232, 93, 28, 0.18);
	}
</style>

<script>
	function initNav() {
		const links = document.querySelectorAll<HTMLAnchorElement>(".nav-link");
		const byId = new Map([...links].map((l) => [l.dataset.nav, l]));

		const observer = new IntersectionObserver(
			(entries) => {
				entries.forEach((entry) => {
					if (!entry.isIntersecting) return;
					links.forEach((l) => l.classList.remove("active"));
					byId.get(entry.target.id)?.classList.add("active");
				});
			},
			{ rootMargin: "-45% 0px -45% 0px" }
		);

		byId.forEach((_, id) => {
			const section = id && document.getElementById(id);
			if (section) observer.observe(section);
		});
	}

	document.addEventListener("astro:page-load", initNav);
</script>
