---
import { Icon } from 'astro-icon/components';
import type { Project } from "../data/content";

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects" class="section wrap">
	<span class="eyebrow" data-reveal>02 — Selected work</span>
	<h2 data-split class="heading mt-6">Recent projects</h2>

	<!-- Panels stick and stack on desktop (sizes in global.css, motion in motion.ts) -->
	<div class="mt-14 space-y-16 lg:space-y-[18vh] lg:pb-[6vh]">
		{projects.map((project, i) => (
			<article style={`--i: ${i}`} class="project-panel relative origin-top border-t border-white/10 pt-8 lg:grid lg:grid-cols-12 lg:gap-10 lg:pb-8">
				<div class="project-dim pointer-events-none absolute inset-0 z-10 bg-ink opacity-0" aria-hidden="true"></div>

				<div class="flex flex-col lg:col-span-4">
					<div class="flex items-center justify-between">
						<span class="font-display text-sm font-bold text-accent">0{i + 1} / 0{projects.length}</span>
						{project.link && (
							<a
								href={project.link.href}
								target="_blank"
								rel="noreferrer noopener"
								aria-label={`Visit ${project.title}`}
								data-magnetic
								class="flex h-11 w-11 items-center justify-center rounded-full bg-white text-ink transition-colors hover:bg-accent hover:text-white"
							>
								<Icon name="lucide:arrow-up-right" width="18" height="18" />
							</a>
						)}
					</div>
					<h3 class="font-display mt-6 text-4xl font-bold uppercase leading-none tracking-tight sm:text-5xl">{project.title}</h3>
					<p class="mt-5 text-sm leading-relaxed text-muted">{project.description}</p>
					{project.points.length > 0 && (
						<ul class="mt-5 space-y-2.5">
							{project.points.map((point) => (
								<li class="flex gap-2.5 text-[13px] leading-relaxed text-[#9a9a9a]">
									<span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent"></span>{point}
								</li>
							))}
						</ul>
					)}
				</div>

				{project.images && project.images.length > 0 && (
					<div data-tilt class="project-shots mt-8 flex flex-col items-center justify-center gap-4 lg:col-span-8 lg:mt-0 lg:h-full">
						{project.images.map((image, j) => (
							<div class="frame w-full">
								<div class="frame-bar" aria-hidden="true"><span></span><span></span><span></span></div>
								<img src={image} alt={`${project.title} screenshot ${j + 1}`} loading="lazy" decoding="async" width="1440" height="778" />
							</div>
						))}
					</div>
				)}
			</article>
		))}
	</div>
</section>
