---
import { Icon } from 'astro-icon/components';
import type { Project } from "../data/content";

interface Props {
	projects: Project[];
}

const { projects } = Astro.props;
---

<section id="projects">
	<div class="wrap pb-12">
		<p class="section-label" data-reveal>(02) Selected work</p>
		<h2 data-split class="display mt-6">
			<span class="block">Recent</span>
			<span class="block ghost">Projects</span>
		</h2>
	</div>

	<!-- Pinned + scrolled horizontally on desktop (motion.ts); plain vertical stack on mobile. -->
	<div id="projects-pin" class="overflow-hidden min-[900px]:flex min-[900px]:h-svh min-[900px]:flex-col min-[900px]:justify-center">
		<div class="projects-track flex flex-col gap-16 px-[var(--gutter)] pl-[max(var(--gutter),var(--rail))] min-[900px]:w-max min-[900px]:flex-row min-[900px]:gap-[6vw] min-[900px]:pr-[20vw]">
			{projects.map((project, i) => {
				const Tag = project.link ? 'a' : 'div';
				return (
					<Tag
						href={project.link?.href}
						target={project.link ? "_blank" : undefined}
						rel={project.link ? "noreferrer noopener" : undefined}
						aria-label={project.link ? `Visit ${project.title}` : undefined}
						class="project-panel group grid gap-8 min-[900px]:h-[78svh] min-[900px]:w-[min(78vw,1180px)] min-[900px]:grid-cols-[1fr_1.15fr] min-[900px]:items-center"
					>
						<div class="project-copy min-w-0">
							<p class="text-[clamp(64px,9vw,140px)] font-black leading-none text-transparent [-webkit-text-stroke:1.5px_#333] transition-colors duration-500 group-hover:[-webkit-text-stroke-color:#e85d1c]" style="font-family: 'Space Grotesk', sans-serif">
								0{i + 1}
							</p>
							<h3 class="mt-4 flex items-center gap-3 text-3xl font-bold leading-tight text-white sm:text-4xl">
								{project.title}
								<Icon name="lucide:arrow-up-right" width="28" height="28" class="text-[#e85d1c] transition-transform duration-300 group-hover:-translate-y-1 group-hover:translate-x-1" />
							</h3>
							<p class="mt-4 text-sm leading-relaxed text-[#888888]">{project.description}</p>
							{project.points.length > 0 && (
								<ul class="mt-5 space-y-2">
									{project.points.map((point) => (
										<li class="flex gap-2 text-[13px] text-[#666666]">
											<span class="mt-2 inline-block h-1 w-1 shrink-0 rounded-full bg-[#e85d1c]/70"></span>
											<span class="leading-relaxed">{point}</span>
										</li>
									))}
								</ul>
							)}
						</div>

						{project.images && project.images.length > 0 && (
							<div class="relative grid gap-4 min-[900px]:h-full min-[900px]:grid-rows-2">
								{project.images.map((image) => (
									<div class="overflow-hidden rounded-2xl border border-[#1c1c1c] bg-[#111]">
										<img
											src={image}
											alt={`${project.title} screenshot`}
											loading="lazy"
											class="project-img aspect-video w-full object-cover object-top min-[900px]:aspect-auto min-[900px]:h-full"
										/>
									</div>
								))}
							</div>
						)}
					</Tag>
				);
			})}
		</div>

	</div>
</section>
