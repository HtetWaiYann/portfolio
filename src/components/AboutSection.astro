---
interface Props {
	about: string[];
}

const { about } = Astro.props;
const [lead, ...rest] = about;
---

<section id="about" class="section wrap">
	<span class="eyebrow" data-reveal>01 — About</span>
	<h2 data-split class="heading mt-6">Who I am</h2>

	<div class="mt-14 grid gap-12 lg:grid-cols-12">
		<div class="lg:col-span-8">
			<p data-words class="text-[clamp(24px,3vw,46px)] font-semibold leading-[1.25] tracking-tight">{lead}</p>
		</div>
		<div class="space-y-8 lg:col-span-4 lg:pt-2">
			{rest.map((paragraph) => (
				<div data-reveal class="border-t border-white/10 pt-5">
					<p class="text-sm leading-relaxed text-muted">{paragraph}</p>
				</div>
			))}
		</div>
	</div>
</section>
