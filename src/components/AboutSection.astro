---
interface Props {
	about: string[];
}

const { about } = Astro.props;
const [lead, ...rest] = about;
---

<section id="about" class="section wrap">
	<p class="section-label" data-reveal>(01) About me</p>
	<p data-words class="mt-10 max-w-6xl text-[clamp(26px,3.6vw,56px)] font-semibold leading-[1.15] tracking-tight text-white">
		{lead}
	</p>
	<div class="mt-16 grid gap-8 md:ml-auto md:max-w-3xl md:grid-cols-2">
		{rest.map((paragraph) => (
			<p data-reveal class="text-sm leading-relaxed text-[#888888]">{paragraph}</p>
		))}
	</div>
</section>
