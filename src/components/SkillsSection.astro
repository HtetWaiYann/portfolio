---
import type { SkillGroups } from "../data/content";

interface Props {
	skills: SkillGroups;
}

const { skills } = Astro.props;

const groups = [
	{ title: "Front-end", items: skills.frontend, span: "lg:col-span-7" },
	{ title: "Back-end", items: skills.backend, span: "lg:col-span-5" },
	{ title: "Databases", items: skills.databases, span: "lg:col-span-4" },
	{ title: "Cloud & DevOps", items: skills.cloudDevops, span: "lg:col-span-8" },
	{ title: "Certifications", items: skills.certifications, span: "lg:col-span-7" },
	{ title: "Languages", items: skills.languages, span: "lg:col-span-5" },
];
---

<section id="skills" class="section wrap">
	<span class="eyebrow" data-reveal>04 — Toolbox</span>
	<h2 data-split class="heading mt-6">Skills &amp; tools</h2>

	<div class="mt-14 grid gap-x-10 gap-y-12 sm:grid-cols-2 lg:grid-cols-12">
		{groups.map((group, i) => (
			<div class={`skill-group border-t border-white/10 pt-6 ${group.span}`}>
				<div class="flex items-baseline justify-between">
					<h3 class="text-[11px] font-semibold uppercase tracking-widest text-accent">{group.title}</h3>
					<span class="font-display text-sm text-white/20">0{i + 1}</span>
				</div>
				<div class="mt-6 flex flex-wrap gap-2">
					{group.items.map((skill) => <span class="chip">{skill}</span>)}
				</div>
			</div>
		))}
	</div>
</section>
