---
import { Icon } from 'astro-icon/components';
import type { Contact, HeroContent } from "../data/content";

interface Props {
	hero: HeroContent;
	contact: Contact;
}

const { hero, contact } = Astro.props;

const socials = [
	{ href: contact.linkedin, icon: "lucide:linkedin", label: "LinkedIn", external: true },
	{ href: contact.github, icon: "lucide:github", label: "GitHub", external: true },
	{ href: `tel:${contact.phone.replace(/\s+/g, "")}`, icon: "lucide:phone", label: "Phone", external: false },
];
---

<section id="intro" class="relative flex min-h-svh flex-col overflow-hidden">
	<div class="hero-glow" aria-hidden="true"></div>

	<div class="hero-inner wrap relative flex w-full flex-1 flex-col pb-10 pt-6">
		<!-- Top bar -->
		<div class="hero-top flex items-center justify-between gap-4">
			<p data-hero class="text-sm font-bold tracking-tight">{hero.name}</p>
			<p data-hero class="hidden items-center gap-2 text-xs text-[#888888] sm:flex">
				<span class="relative flex h-2 w-2">
					<span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-green-400 opacity-60"></span>
					<span class="relative inline-flex h-2 w-2 rounded-full bg-green-400"></span>
				</span>
				{contact.availability}
			</p>
			{contact.bookingUrl && (
				<button type="button" data-hero data-magnetic data-book class="rounded-full bg-white px-5 py-2.5 text-xs font-semibold text-[#0a0a0a] transition-colors hover:bg-[#e85d1c] hover:text-white">
					Book a free call
				</button>
			)}
		</div>

		<!-- Headline + portrait -->
		<div class="relative flex flex-1 flex-col justify-center py-12">
			<h1 class="hero-title font-black uppercase tracking-tighter">
				<span class="hero-line text-white">Full Stack</span>
				<span class="hero-line outline-text text-right">Developer</span>
			</h1>

			<div class="pointer-events-none z-10 order-first mb-14 self-center md:absolute md:left-1/2 md:top-1/2 md:order-none md:mb-0 md:-translate-x-1/2 md:-translate-y-1/2">
				<div class="relative -rotate-6">
					<div class="hero-ring absolute -inset-6 rounded-full border-2 border-dashed border-[#e85d1c]/55" aria-hidden="true"></div>
					<div class="hero-ring absolute -inset-14 rounded-full border border-dashed border-[#e85d1c]/20" aria-hidden="true"></div>
					<div class="hero-card h-[180px] w-[150px] overflow-hidden rounded-[28px] bg-[#e85d1c] shadow-2xl shadow-black/60 sm:h-[280px] sm:w-[230px]">
						<img
							class="h-full w-full object-cover object-top"
							src={hero.image}
							alt={hero.imageAlt}
							width="230"
							height="280"
							loading="eager"
						/>
					</div>
				</div>
			</div>
		</div>

		<!-- Bottom row -->
		<div class="hero-bottom grid items-end gap-8 md:grid-cols-[1.2fr_1fr]">
			<div>
				<p data-hero class="max-w-md text-sm leading-relaxed text-[#888888]">{hero.heroSummary}. {hero.summary.split(". ")[0]}.</p>
				<div data-hero class="mt-6 flex flex-wrap items-center gap-3">
					<a
						data-magnetic
						href="/HtetWaiYan_Resume.pdf"
						download
						class="inline-flex items-center gap-2 rounded-full bg-[#e85d1c] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#d44f0f]"
					>
						<Icon name="lucide:download" width="16" height="16" />
						Download CV
					</a>
					{socials.map((s) => (
						<a
							data-magnetic
							href={s.href}
							target={s.external ? "_blank" : undefined}
							rel={s.external ? "noreferrer" : undefined}
							aria-label={s.label}
							class="flex h-11 w-11 items-center justify-center rounded-full border border-[#2a2a2a] text-[#888888] transition-colors hover:border-[#e85d1c] hover:text-white"
						>
							<Icon name={s.icon} width="17" height="17" />
						</a>
					))}
				</div>
			</div>

			<div class="flex flex-wrap gap-x-10 gap-y-4 md:justify-end">
				{hero.highlights.map((stat) => (
					<div data-hero class="max-w-[220px]">
						<div data-count class:list={["font-black text-white", stat.value.length > 4 ? "text-base leading-snug" : "text-3xl sm:text-4xl"]}>{stat.value}</div>
						<div class="mt-1 text-[10px] font-semibold uppercase tracking-widest text-[#555555]">{stat.label}</div>
					</div>
				))}
			</div>
		</div>
	</div>
</section>
