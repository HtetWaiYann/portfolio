---
import type { Education } from "../data/content";

interface Props {
	education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="section wrap">
	<p class="section-label" data-reveal>(05) Education</p>
	<h2 data-split class="display mt-6">
		<span class="block">Education</span>
		<span class="block ghost">& Learning</span>
	</h2>

	<div class="mt-16 border-t border-[#1c1c1c]">
		{education.map((item) => {
			const [degree, school] = item.title.split(" · ");
			return (
				<div data-reveal class="group grid gap-2 border-b border-[#1c1c1c] py-8 transition-[padding] duration-500 hover:pl-4 md:grid-cols-[1.3fr_1fr_auto] md:items-center md:gap-8">
					<h3 class="text-xl font-semibold text-white transition-colors group-hover:text-[#e85d1c] sm:text-2xl">{degree}</h3>
					<p class="text-sm text-[#888]">{school}</p>
					<p class="text-xs text-[#555] md:text-right">{item.period}</p>
				</div>
			);
		})}
	</div>
</section>
