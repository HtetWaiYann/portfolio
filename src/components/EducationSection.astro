---
import { Icon } from 'astro-icon/components';
import type { Education } from "../data/content";

interface Props {
	education: Education[];
}

const { education } = Astro.props;
---

<section id="education" class="section wrap">
	<span class="eyebrow" data-reveal>05 — Education</span>
	<h2 data-split class="heading mt-6">Learning</h2>

	<div class="edu-grid mt-14 grid gap-10 md:grid-cols-3">
		{education.map((item) => {
			const [degree, school] = item.title.split(" · ");
			return (
				<div class="edu-card flex flex-col gap-8 border-t border-white/10 pt-6">
					<span class="flex h-11 w-11 items-center justify-center rounded-full bg-accent/15 text-accent">
						<Icon name="lucide:graduation-cap" width="20" height="20" />
					</span>
					<div>
						<h3 class="text-xl font-semibold leading-snug">{degree}</h3>
						<p class="mt-2 text-sm text-muted">{school}</p>
						<p class="mt-5 text-xs text-white/40">{item.period}</p>
					</div>
				</div>
			);
		})}
	</div>
</section>
